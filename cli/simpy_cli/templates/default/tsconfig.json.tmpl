{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "simpy-ts/frontend": ["./.simpy/frontend/index.ts"],
      "simpy-ts/api": ["./.simpy/api.ts"]
    }
  },
  "include": ["pages", ".simpy"]
}
